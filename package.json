{
  "name": "icono-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,components,data,lib}/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"{app,components,data,lib}/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\""
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
